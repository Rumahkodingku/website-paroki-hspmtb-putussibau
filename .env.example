# =============================================================================
# Contoh konfigurasi lokal — Paroki HSPMTB Putussibau
# =============================================================================
# Salin ke .env, lalu jalankan `php artisan key:generate`:
#   cp .env.example .env
#
# File .env tidak pernah di-commit. Nilai staging/production diisi melalui
# environment Coolify, bukan melalui file ini.
# Lihat docs/DEVELOPMENT.md dan docs/deployment/docker-coolify.md.

# -----------------------------------------------------------------------------
# 1. Aplikasi
# -----------------------------------------------------------------------------
APP_NAME="Paroki HSPMTB Putussibau"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# D-01: penyimpanan UTC, tampilan Asia/Pontianak.
APP_DISPLAY_TIMEZONE=Asia/Pontianak

# NFR-I18N: seluruh UI, validasi, dan notifikasi memakai Bahasa Indonesia.
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# Opsional: kunci lama saat rotasi APP_KEY (pisahkan dengan koma).
# APP_PREVIOUS_KEYS=

# Opsional: diisi oleh pipeline deployment, dipakai manifest backup.
APP_VERSION=
APP_COMMIT=

# -----------------------------------------------------------------------------
# 2. Logging
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# 3. Database
# -----------------------------------------------------------------------------
# MySQL 8+ dengan utf8mb4. Buat database sekali:
#   CREATE DATABASE website_paroki_hspmtb      CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
#   CREATE DATABASE website_paroki_hspmtb_test CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
# Database test dipakai phpunit.xml dan E2E. Lihat D-03.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=website_paroki_hspmtb
DB_USERNAME=root
DB_PASSWORD=
DB_COLLATION=utf8mb4_0900_ai_ci

# Jangan set DB_URL. Laravel membacanya sebagai connection URL bila ada.

# Harus lebih besar dari timeout queue worker agar job tidak diambil dua kali.
DB_QUEUE_RETRY_AFTER=600

# -----------------------------------------------------------------------------
# 4. Super Admin awal dan Installation Wizard
# -----------------------------------------------------------------------------
# ADMIN_EMAIL atau ADMIN_PASSWORD kosong membuat SuperAdminSeeder dilewati.
# Jangan isi kredensial nyata di file ini. Lihat D-17.
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Wizard hanya untuk instalasi baru. Kembalikan ke false setelah selesai.
# Lihat D-90.
INSTALLER_ENABLED=false
# Container deployment tidak menulis .env; set false di Coolify.
INSTALLER_WRITE_ENV=true

# -----------------------------------------------------------------------------
# 5. Session, cache, queue, broadcast
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true hanya di deployment HTTPS.
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
# CACHE_PREFIX=

QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# -----------------------------------------------------------------------------
# 6. Storage dan Backup
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local

# Dokumen memakai disk privat, bukan public.
DOCUMENTS_DISK=local

# Arsip backup selalu di disk privat. Binary dipakai untuk dump/restore.
BACKUPS_DISK=backups
BACKUPS_QUEUE_CONNECTION=backups
BACKUPS_QUEUE=backups
BACKUPS_QUEUE_RETRY_AFTER=7300
BACKUPS_MYSQLDUMP_PATH=mysqldump
BACKUPS_MYSQL_PATH=mysql
# Khusus test integrasi restore; dibuat dan dihapus oleh test.
# BACKUP_RESTORE_TEST_DATABASE=website_paroki_hspmtb_restore_test

# -----------------------------------------------------------------------------
# 7. Email
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@paroki-hspmtb.local"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# 8. Frontend dan Inertia
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# Jangan aktifkan SSR tanpa daemon Node di server. Lihat D-26.
INERTIA_SSR_ENABLED=false

# Ilustrasi stok hanya untuk review lokal, bukan foto paroki. Lihat D-71.
HOMEPAGE_ILLUSTRATIONS=false

# -----------------------------------------------------------------------------
# 9. Pengembangan dan pengujian
# -----------------------------------------------------------------------------
# Telescope hanya untuk lokal.
TELESCOPE_ENABLED=true

# Isi konten demo saat `migrate:fresh --seed`. Lihat D-53.
DEMO_SEED=true

# E2E memakai database sendiri; `app:e2e:prepare` yang menjalankan migrate:fresh.
E2E_DATABASE=website_paroki_hspmtb_test
# E2E_ADMIN_NAME="Super Admin E2E"
# E2E_ADMIN_EMAIL=e2e-admin@example.test
# E2E_ADMIN_PASSWORD="E2e-Admin-2026!"

# Opsional: secret passkey. Default-nya memakai APP_KEY.
# PASSKEYS_USER_HANDLE_SECRET=

# -----------------------------------------------------------------------------
# 10. Cloud storage opsional (S3)
# -----------------------------------------------------------------------------
# Hapus komentar hanya bila memakai disk s3.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false
